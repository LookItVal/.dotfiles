{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Theme: Set Multi-Color Workspace Palette",
            "type": "shell",
            "command": "node \"${env:HOME}/.config/scripts/vscode-palette-picker.js\" \"${workspaceFolder}\" \"${input:mainBackgroundColor}\" \"${input:accentColor}\" \"${input:foregroundColor}\" \"${input:addToGitignore}\"",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "close": true
            }
        },
        {
            "label": "Theme: Clear Workspace Palette",
            "type": "shell",
            "command": "node \"${env:HOME}/.config/scripts/vscode-palette-picker.js\" \"${workspaceFolder}\" --clear",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "close": true
            }
        }
    ],
