/* Catppuccin Macchiato card theme — matches ~/.config/claude/usage-menu.sh */
@import "catppuccin-macchiato"

configuration {
  show-icons:   true;
  icon-theme:   "Papirus";
  display-drun: "";
  display-run:  "";
  display-window: "";
  display-combi: "";
  display-ssh:  "󰣀";
  drun-display-format: "{name}";
}

* {
  font:             "FiraCode Nerd Font 12";
  background-color: transparent;
  text-color:       @text;
  spacing:          0;

  /* Re-point rofi's built-in (light Solarized) color names at Catppuccin, so any widget
     this file doesn't style explicitly still gets readable colors instead of dark-on-dark. */
  foreground:                  @text;
  background:                  @base;
  lightfg:                     @text;
  lightbg:                     @mantle;
  separatorcolor:              @surface1;
  border-color:                @mauve;
  normal-foreground:           @text;
  normal-background:           transparent;
  alternate-normal-foreground: @text;
  alternate-normal-background: transparent;
  selected-normal-foreground:  @text;
  selected-normal-background:  @surface0;
  active-foreground:           @blue;
  urgent-foreground:           @red;
}

window {
  location:         center;
  width:            44em;
  padding:          14px;
  border:           2px;
  border-color:     @mauve;
  border-radius:    10px;
  background-color: @base;
}

mainbox {
  children: [ "inputbar", "message", "listview" ];   /* no mode tabs: launcher is apps-only */
  spacing:  10px;
}

/* ---- search bar ---- */
inputbar {
  children:         [ "prompt", "entry", "num-filtered-rows", "textbox-num-sep", "num-rows" ];
  padding:          8px 12px;
  spacing:          10px;
  border-radius:    6px;
  background-color: @surface0;
}
prompt            { text-color: @mauve; }
entry             { text-color: @text; cursor-color: @rosewater; placeholder: "Search"; placeholder-color: @overlay0; cursor: text; }
num-filtered-rows { text-color: @overlay0; expand: false; }
textbox-num-sep   { text-color: @overlay0; expand: false; str: "/"; }
num-rows          { text-color: @overlay0; expand: false; }

/* ---- message (used by usage-menu and other -mesg popups) ---- */
message { padding: 0 0 6px 0; }
textbox { text-color: @text; }

/* ---- results ---- */
listview {
  lines:        8;
  columns:      1;
  fixed-height: true;
  scrollbar:    false;
  spacing:      6px;
  cycle:        true;
}

element {
  padding:       6px 10px;
  spacing:       10px;
  border-radius: 6px;
  cursor:        pointer;
}
element normal.normal, element alternate.normal { background-color: transparent; text-color: @text; }
element normal.urgent, element alternate.urgent { background-color: transparent; text-color: @red; }
element normal.active, element alternate.active { background-color: transparent; text-color: @blue; }
element selected.normal { background-color: @surface0; text-color: @text; }
element selected.urgent { background-color: @red;      text-color: @base; }
element selected.active { background-color: @surface0; text-color: @blue; }

element-icon { size: 1.2em; cursor: inherit; }
element-text { text-color: inherit; highlight: bold #c6a0f6; cursor: inherit; vertical-align: 0.5; }

/* ---- rofi -e errors ---- */
error-message { padding: 14px; border: 2px; border-color: @red; border-radius: 10px; background-color: @base; }
